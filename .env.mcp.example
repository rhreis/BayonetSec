# Agent Configuration
AGENT_ARCHITECT_ENABLED=true
AGENT_ENGINEER_ENABLED=true
AGENT_QA_ENABLED=true
AGENT_DEVOPS_ENABLED=true
AGENT_SECURITY_ENABLED=true

# Workflow Configuration
